parameters:
    level: max
    paths:
        - src
        - tests
    ignoreErrors:
        # PHPDoc is prohibited inside src/Internal/; iterable value types on the request
        # log payload (body and query parameters) cannot be expressed there.
        - identifier: missingType.iterableValue
          path: src/Internal/LogRequest.php

        # PHPDoc is prohibited inside src/Internal/; iterable value types on the response
        # log payload (decoded body) cannot be expressed there.
        - identifier: missingType.iterableValue
          path: src/Internal/LogResponse.php

        # The request context returned by LogRequest::toContext() is typed as `array`, so
        # PHPStan cannot infer the shape consumed by the LogResponse factory.
        - identifier: argument.type
          path: src/Internal/LogResponse.php

        # PHPDoc is prohibited inside tests/; the captured context arrays cannot carry a
        # value type, so PHPStan flags offset access on the assertions.
        - identifier: offsetAccess.nonOffsetAccessible
          path: tests/Unit/LogMiddlewareTest.php
    reportUnmatchedIgnoredErrors: true
